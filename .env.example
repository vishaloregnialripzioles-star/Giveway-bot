# Create an application and bot at https://discord.com/developers/applications
DISCORD_TOKEN=
CLIENT_ID=

# PostgreSQL connection string. Use Render's Internal Database URL when the
# worker and database are in the same Render region.
DATABASE_URL=

# Optional: register commands to one development server for near-instant updates.
# Leave blank in production to register globally (global updates can take a while).
GUILD_ID=

# Set to true only if your PostgreSQL provider requires TLS and the URL does not
# already specify sslmode=require.
PGSSL=false
